# ═══════════════════════════════════════════════════════
# ExtAT Platform — Configuração (modelo)
# Copie para .env e ajuste:  cp .env.example .env
# ═══════════════════════════════════════════════════════

# Porta do servidor HTTP
PORT=3001

# Caminho do banco SQLite (relativo à raiz do projeto ou absoluto)
DB_PATH=./data/extat.db

# Segredo JWT (OBRIGATÓRIO — gere com:
#   deno eval "console.log(crypto.randomUUID().replaceAll('-','')+crypto.randomUUID().replaceAll('-',''))" )
JWT_SECRET=<gere-um-segredo-aqui>

# Validade do token de autenticação
AUTH_TOKEN_EXPIRATION=7d

# Custo do bcrypt (hash de senha)
BCRYPT_SALT_ROUNDS=10

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Ambiente: development | production
NODE_ENV=development
